#!/usr/bin/env bash
# yuki-brightness get | set <0-100> | step <+N|-N>
# Laptop backlight -> brightnessctl (backlight class only, never the LAN/keyboard LEDs).
# External monitor -> DDC/CI through ddcutil (VCP 0x10). ddcutil is slow (~0.3-1 s per call), so the last value is cached
# for 30 s and writes are serialised with flock; the shell sends the newest slider value as soon as the previous write ends.
rt="${XDG_RUNTIME_DIR:-/tmp}"; cache="$rt/yuki-brightness.val"; busf="$rt/yuki-brightness.bus"; lock="$rt/yuki-brightness.lock"

backlight() { brightnessctl -c backlight -m 2>/dev/null | head -n1; }
bus() {
    [ -s "$busf" ] || ddcutil detect --brief 2>/dev/null | sed -n 's#.*I2C bus: */dev/i2c-\([0-9]*\).*#\1#p' | head -n1 > "$busf"
    cat "$busf"
}
fresh() { [ -s "$cache" ] && [ $(( $(date +%s) - $(stat -c %Y "$cache") )) -lt 30 ]; }

get() {   # prints a percentage
    if [ -n "$(backlight)" ]; then backlight | cut -d, -f4 | tr -d %; return; fi
    if fresh; then cat "$cache"; return; fi
    local b; b=$(bus); [ -n "$b" ] || return 1
    ddcutil --bus "$b" getvcp 10 --brief 2>/dev/null | awk '$1=="VCP" && $3=="C" { print $4; exit }' | tee "$cache"
}
set_() {  # set_ <pct>
    local p=$1; [ "$p" -lt 1 ] && p=1; [ "$p" -gt 100 ] && p=100
    if [ -n "$(backlight)" ]; then brightnessctl -c backlight -q set "${p}%"; return; fi
    echo "$p" > "$cache"
    local b; b=$(bus); [ -n "$b" ] || return 1
    # fast path ~80 ms (skips the per-call capability checks, short sleeps); one slow, safe retry if the monitor NAKs it
    flock "$lock" sh -c 'ddcutil --bus "$1" --noverify --skip-ddc-checks --sleep-multiplier 0.1 setvcp 10 "$2" || ddcutil --bus "$1" --noverify setvcp 10 "$2"' _ "$b" "$p" >/dev/null 2>&1
}

case "${1:-get}" in
    get)  get ;;
    getm) v=$(get) && echo "yuki,monitor,$v,${v}%" ;;          # brightnessctl -m shaped, for the shell
    set)  set_ "$2" ;;
    step) cur=$(get) || exit 1; set_ $(( cur + $2 )) ;;
    *)    echo "usage: yuki-brightness get|set N|step +N|-N" >&2; exit 2 ;;
esac
