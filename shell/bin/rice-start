#!/bin/sh
# rice-start: starts RiceShell (this repo's fork of MacShell) for the Hyprland session.
#   rice-start [ConfigName]      default: RiceShell
# Your own environment variables go in ~/.config/hypr-rice/env
# Log: ~/.local/state/hypr-rice/<ConfigName>.log
NAME="${1:-RiceShell}"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/hypr-rice"
LOG="$STATE/$NAME.log"
AUTO="$STATE/auto-env"
PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"; export PATH

mkdir -p "$STATE" 2>/dev/null
# keep the log small
if [ -f "$LOG" ] && [ "$(wc -c < "$LOG" 2>/dev/null | tr -d ' ')" -gt 1048576 ] 2>/dev/null; then mv -f "$LOG" "$LOG.old" 2>/dev/null; fi
log() { printf '%s rice-start: %s\n' "$(date '+%F %T')" "$*" >> "$LOG" 2>/dev/null; }

command -v qs >/dev/null 2>&1 || { echo "rice-start: qs (quickshell) not found in PATH" >&2; log "qs (quickshell) not found in PATH"; exit 1; }

# wait (up to 20 s) until the Wayland socket exists
i=0
while [ "$i" -lt 100 ]; do
    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$WAYLAND_DISPLAY" ]; then break; fi
    i=$((i + 1)); sleep 0.2
done

# already running for this user? then there is nothing to do
if pgrep -u "$(id -u)" -f "(^|/)(qs|quickshell)( .*)? (-c|--config) $NAME( |\$)" >/dev/null 2>&1; then exit 0; fi

# ── environment: the variables Qt and Quickshell need, whatever started this script ──
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-Hyprland}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
# graphics settings this script picked by itself after crashes (lowest priority), then your own settings, which win
if [ -f "$AUTO" ]; then set -a; . "$AUTO"; set +a; fi
if [ -f "$CONF/hypr-rice/env" ]; then set -a; . "$CONF/hypr-rice/env"; set +a; fi
# icon theme: yours (QS_ICON_THEME or qt6ct), else the GTK one, else the first well-known theme that is installed
if [ -z "${QS_ICON_THEME:-}" ] && [ -z "${QT_QPA_PLATFORMTHEME:-}" ]; then
    has_theme() { [ -f "/usr/share/icons/$1/index.theme" ] || [ -f "$HOME/.local/share/icons/$1/index.theme" ] || [ -f "$HOME/.icons/$1/index.theme" ]; }
    t=""
    for f in "$CONF/gtk-3.0/settings.ini" "$CONF/gtk-4.0/settings.ini"; do
        [ -n "$t" ] && break
        [ -f "$f" ] && t=$(sed -n 's/^gtk-icon-theme-name *= *//p' "$f" | head -n1)
    done
    if [ -z "$t" ] || ! has_theme "$t"; then
        t=""
        for c in Papirus-Dark Papirus WhiteSur-dark WhiteSur Tela Adwaita breeze Numix; do
            if has_theme "$c"; then t="$c"; break; fi
        done
    fi
    [ -n "$t" ] && export QS_ICON_THEME="$t"
fi
# portals and services started later by D-Bus / systemd need to know the session too
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP >/dev/null 2>&1
fi

# ── wallpaper: awww forgets it at every reboot. If awww was used before (and no other wallpaper tool runs), bring it back
# now; the shell also re-applies the wallpaper you picked, a few seconds later.
if command -v awww-daemon >/dev/null 2>&1 && [ -n "$(ls -A "${XDG_CACHE_HOME:-$HOME/.cache}/awww" 2>/dev/null)" ] \
   && ! pgrep -x hyprpaper >/dev/null 2>&1 && ! pgrep -x swaybg >/dev/null 2>&1 && ! pgrep -x mpvpaper >/dev/null 2>&1; then
    (
        awww query >/dev/null 2>&1 || setsid awww-daemon >/dev/null 2>&1 &
        n=0; while [ "$n" -lt 20 ]; do awww query >/dev/null 2>&1 && break; n=$((n + 1)); sleep 0.25; done
        awww restore >/dev/null 2>&1
    ) &
fi

# ── run the shell; restart it when it crashes. After repeated quick crashes, try simpler graphics settings (only the
# ones you have not set yourself): OpenGL, then the basic render loop, then software drawing (no Liquid Glass).
# A setting that gets the shell running is remembered in $AUTO (delete that file to go back to the defaults).
applied=""; soft=0
rung() { # rung <number of quick crashes so far>
    [ "$1" -ge 2 ] || return 0
    if [ -z "${QSG_RHI_BACKEND:-}" ]; then export QSG_RHI_BACKEND=opengl; applied="$applied QSG_RHI_BACKEND=opengl"; fi
    [ "$1" -ge 3 ] || return 0
    if [ -z "${QSG_RENDER_LOOP:-}" ]; then export QSG_RENDER_LOOP=basic; applied="$applied QSG_RENDER_LOOP=basic"; fi
    [ "$1" -ge 4 ] || return 0
    if [ -z "${QT_QUICK_BACKEND:-}" ]; then export QT_QUICK_BACKEND=software; soft=1; fi
}
fast=0
while :; do
    rung "$fast"
    log "starting qs -c $NAME (attempt $((fast + 1)))${applied:+, fallback settings:$applied}$([ "$soft" = 1 ] && printf ' QT_QUICK_BACKEND=software')"
    start=$(date +%s)
    qs -c "$NAME" >>"$LOG" 2>&1 &
    pid=$!
    if [ -n "$applied" ] && [ "$soft" = 0 ] && [ ! -s "$AUTO" ]; then
        keep="$applied"
        ( sleep 10; if kill -0 "$pid" 2>/dev/null; then for kv in $keep; do printf '%s\n' "$kv"; done > "$AUTO"; log "remembered:$keep"; fi ) &
    fi
    wait "$pid"
    rc=$?
    case "$rc" in 0|130|143) exit 0 ;; esac          # quit on purpose (qs kill / Ctrl+C / SIGTERM)
    now=$(date +%s)
    log "qs exited with code $rc after $((now - start)) s"
    if [ $((now - start)) -lt 5 ]; then fast=$((fast + 1)); else fast=0; fi
    if [ "$fast" -ge 6 ]; then
        msg="RiceShell keeps crashing right after it starts. See $LOG   (or run:  qs -c $NAME   and  bash install.sh --doctor)"
        echo "rice-start: $msg" >&2
        log "giving up: $msg"
        command -v notify-send >/dev/null 2>&1 && notify-send -u critical "RiceShell" "$msg"
        exit 1
    fi
    sleep 1
done
