#!/usr/bin/env python3
"""Open a new Chromium window as a floating, centred one (Super+Shift+W).

An exec rule can't do this: when Chromium is already running, the new window is created by that running process,
so Hyprland never sees the pid it spawned. Instead: remember the Chromium windows, start one, float whichever appears."""
import json, subprocess, sys, time

W, H = 1280, 800


def hc(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def chromium_windows():
    try:
        return {c["address"] for c in json.loads(hc("-j", "clients")) if c["class"].lower() == "chromium"}
    except ValueError:
        return set()


before = chromium_windows()
subprocess.Popen(["chromium", "--new-window", *sys.argv[1:]], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                 stderr=subprocess.DEVNULL, start_new_session=True)

deadline = time.time() + 10
while time.time() < deadline:
    new = chromium_windows() - before
    if new:
        sel = f'window = "address:{sorted(new)[0]}"'
        hc("dispatch", f"hl.dsp.window.float({{ action = \"enable\", {sel} }})")
        hc("dispatch", f"hl.dsp.window.resize({{ x = {W}, y = {H}, \"exact\", {sel} }})")
        hc("dispatch", f"hl.dsp.window.center({{ {sel} }})")
        break
    time.sleep(0.1)
