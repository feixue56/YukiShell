#!/usr/bin/env python3
"""Super+Shift+Tab: toggle the window under the mouse pointer (falls back to the focused window) between its normal look
and a transparent / solid alternative.

kitty windows: switch between the liquid-glass look (background_opacity from kitty.conf, blurred by Hyprland) and a fully
solid background. Only the BACKGROUND changes (kitty's own background_opacity via remote control), so the text is never
touched. Other apps: a per-app window rule fades the whole window (text included; nothing can avoid that) and is toggled."""
import json, os, subprocess, sys

KITTY_LEVEL = "1.0"     # kitty background opacity while "solid"; the other state is the liquid-glass value from kitty.conf
WINDOW_LEVEL = "0.92"   # other apps: whole-window opacity, kept subtle (the content fades with it, there is no way around that)

def hc(*a):
    return subprocess.run(["hyprctl", *a], capture_output=True, text=True).stdout

def target():
    if len(sys.argv) > 1:                               # toggle-opacity <address>: act on that window
        return next((c for c in json.loads(hc("-j", "clients")) if c["address"] == sys.argv[1]), None)
    cx, cy = (float(v) for v in hc("cursorpos").replace(" ", "").split(","))
    shown = {m["activeWorkspace"]["id"] for m in json.loads(hc("-j", "monitors"))}
    hit = [c for c in json.loads(hc("-j", "clients"))
           if c["mapped"] and not c["hidden"] and c["workspace"]["id"] in shown
           and c["at"][0] <= cx < c["at"][0] + c["size"][0] and c["at"][1] <= cy < c["at"][1] + c["size"][1]]
    if hit:                                             # floating windows sit above tiled ones; then most recently focused
        return min(hit, key=lambda c: (not c["floating"], c["focusHistoryID"]))
    return json.loads(hc("-j", "activewindow") or "{}") or None

def kitty_toggle(pid):
    r = subprocess.run(["kitty", "@", "--to", f"unix:@kitty-{pid}", "set-background-opacity", "--all", "--toggle", KITTY_LEVEL],
                       capture_output=True, text=True)
    return r.returncode == 0

w = target()
if not w or not w.get("address"):
    sys.exit(0)
def window_opacity():
    try:
        return float(hc("getprop", f"address:{w['address']}", "opacity").strip())
    except ValueError:
        return -1.0

def set_window_opacity(value):
    for prop in ("opacity", "opacity_inactive", "opacity_fullscreen"):
        hc("dispatch", f'hl.dsp.window.set_prop({{ prop = "{prop}", value = "{value}", window = "address:{w["address"]}" }})')

STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "toggle-opacity.json")

def kitty_shortcut(solid_now):
    """kitty started without remote control: press its own opacity shortcuts in that window (ctrl+shift+a, then 1 = solid /
    d = back to the configured glass). Hyprland can't read the result back, so which state we are in is remembered."""
    addr = w["address"]
    send = lambda mods, key: hc("dispatch", f'hl.dsp.send_shortcut({{ mods = "{mods}", key = "{key}", window = "address:{addr}" }})')
    send("CTRL_SHIFT", "a")
    send("", "d" if solid_now else "1")

if w["class"] == "kitty" or w["class"].startswith("dash-"):
    if 0 < window_opacity() < 1:                        # a whole-window fade (older toggle / fallback) is on: this press undoes it
        set_window_opacity("-1")
        sys.exit(0)
    if kitty_toggle(w["pid"]):
        sys.exit(0)                                     # background only, text untouched
    try: state = json.load(open(STATE))
    except (OSError, ValueError): state = {}
    live = {c["address"] for c in json.loads(hc("-j", "clients"))}
    state = {a: v for a, v in state.items() if a in live}          # forget windows that are gone
    solid = state.get(w["address"], False)
    kitty_shortcut(solid)
    state[w["address"]] = not solid
    json.dump(state, open(STATE, "w"))
    sys.exit(0)
# Not kitty. No compositor can make only an app's background transparent (it only ever sees the finished window), so this
# fades the WHOLE window, text included. It is done with a per-app window rule: pressing the key on an app adds a rule for
# its class (every window of that app, survives reloads and restarts); pressing it again removes the rule.
import re, string
APPS = os.path.expanduser("~/.config/hypr-rice/transparent-apps.txt")
cls = w["class"]
if not cls:
    sys.exit(0)
try: apps = [l.strip() for l in open(APPS) if l.strip()]
except OSError: apps = []
on = cls not in apps
if on: apps.append(cls)
else: apps.remove(cls)
os.makedirs(os.path.dirname(APPS), exist_ok=True)
open(APPS, "w").write("".join(a + "\n" for a in apps))

# The rule only reaches windows opened from now on (and after reloads / restarts); the windows already open get the value
# set directly. An explicit per-window value also beats any leftover fade from an older version of this script.
for c in json.loads(hc("-j", "clients")):
    if c["class"] == cls:
        # no_blur is cleared too: older versions set it, and without the blur whatever sits behind the window (desktop widgets)
        # shows through as crisp ghost text instead of a smear.
        for prop, value in (("opacity", WINDOW_LEVEL), ("opacity_inactive", WINDOW_LEVEL), ("opacity_fullscreen", WINDOW_LEVEL), ("no_blur", "false")):
            if not on and prop != "no_blur":
                value = "-1"
            hc("dispatch", f'hl.dsp.window.set_prop({{ prop = "{prop}", value = "{value}", window = "address:{c["address"]}" }})')
rx = "^" + "".join("\\" + ch if ch in string.punctuation else ch for ch in cls) + "$"
rule = ('hl.window_rule({ name = %s, match = { class = %s }, opacity = "%s %s", enabled = %s })'
        % (json.dumps("yuki-transparent-" + cls), json.dumps(rx), WINDOW_LEVEL, WINDOW_LEVEL, "true" if on else "false"))
hc("eval", rule)
