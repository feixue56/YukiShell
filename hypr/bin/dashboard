#!/usr/bin/env bash
# Super+Alt+D: toggle the dashboard — fff on the left, tty-clock top-right, cava bottom-right (kitty windows, tiled).
# Press again to close them. Windows are tagged by class (dash-*) so nothing else is touched.
count() { hyprctl -j clients | python3 -c 'import json,sys; print(sum(c["class"].startswith("dash-") for c in json.load(sys.stdin)))'; }

if [ "$(count)" -gt 0 ]; then
    hyprctl -j clients | python3 -c 'import json,sys; [print(c["address"]) for c in json.load(sys.stdin) if c["class"].startswith("dash-")]' |
        while read -r a; do hyprctl dispatch "hl.dsp.window.close({ window = \"address:$a\" })" >/dev/null; done
    exit 0
fi

open() {  # open <class> <command...>; wait for the window before the next one so the tiling splits in order
    local n; n=$(count); local cls=$1; shift
    kitty --class "$cls" "$@" >/dev/null 2>&1 &
    for _ in $(seq 40); do [ "$(count)" -gt "$n" ] && break; sleep 0.05; done
}
pre() { hyprctl dispatch "hl.dsp.layout(\"preselect $1\")" >/dev/null; }
# cava first (fills the workspace), then fff splits off above it, then the clock splits off to fff's right.
open dash-cava  cava -p "$HOME/.config/cava/dashboard.conf"
pre u; open dash-fff   fish -C fff
pre r; open dash-clock tty-clock -scb -C 5
# fff 40 px wider (the clock window gets 40 px narrower on its left edge)
fff=$(hyprctl -j clients | python3 -c 'import json,sys; print(next(c["address"] for c in json.load(sys.stdin) if c["class"]=="dash-fff"))')
hyprctl dispatch "hl.dsp.window.resize({ x = 40, y = 0, relative = true, window = \"address:$fff\" })" >/dev/null
