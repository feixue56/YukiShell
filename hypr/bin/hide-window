#!/usr/bin/env python3
"""Hide or show a window with one key (Super+Alt+S).

  hide-window          the toggle: nothing hidden -> hide the focused window; something hidden -> show the window hidden last
  hide-window hide     always hide the focused window (the menu bar's "Hide <app>"), so several can be hidden
  hide-window show     show the window hidden last (the menu bar's "Show Hidden Windows")

Hiding moves the window to the special workspace "hidden" and remembers where it was (its workspace, floating or tiled, position
and size, full screen); showing puts it back exactly like that and gives it the focus.

The remembered windows live in $XDG_RUNTIME_DIR/yukishell-hidden.json (newest last). A window that was closed while hidden is
dropped from it. Windows that were put in "hidden" some other way (no record) come back to the current workspace."""
import json, os, subprocess, sys

STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "yukishell-hidden.json")
HIDDEN = "special:hidden"


def hc(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def hj(what):
    try:
        return json.loads(hc("-j", what))
    except ValueError:
        return {} if what == "activewindow" else []


def dispatch(lua):
    hc("dispatch", lua)


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return []


def save(entries):
    with open(STATE, "w") as f:
        json.dump(entries, f)


def lua_str(s):
    return json.dumps(str(s))      # a JSON string is a valid Lua string literal for the names Hyprland uses


def ws_selector(ws):
    # a numbered workspace by its id, any other (named) one by its name
    return str(ws["id"]) if isinstance(ws.get("id"), int) and ws["id"] > 0 else lua_str(ws.get("name", ""))


def restore(entry):
    sel = f'window = "address:{entry["address"]}"'
    dispatch(f"hl.dsp.window.move({{ workspace = {entry['workspace']}, follow = false, {sel} }})")
    dispatch(f"hl.dsp.focus({{ {sel} }})")
    if entry.get("floating"):
        dispatch(f'hl.dsp.window.float({{ action = "enable", {sel} }})')
        w, h = entry["size"]
        x, y = entry["at"]
        dispatch(f"hl.dsp.window.resize({{ x = {w}, y = {h}, {sel} }})")
        dispatch(f"hl.dsp.window.move({{ x = {x}, y = {y}, {sel} }})")
    elif entry.get("floating") is False:
        dispatch(f'hl.dsp.window.float({{ action = "disable", {sel} }})')
    fs = entry.get("fullscreen", 0)
    if fs:
        dispatch(f'hl.dsp.window.fullscreen({{ mode = "{"maximized" if fs == 1 else "fullscreen"}", action = "set" }})')


def main(mode):
    clients = {c["address"]: c for c in hj("clients")}
    in_hidden = {a for a, c in clients.items() if c.get("workspace", {}).get("name") == HIDDEN}

    # forget windows that were closed (or taken out of "hidden" by hand) since they were hidden
    entries = [e for e in load() if e.get("address") in in_hidden]

    if mode != "hide" and entries:
        entry = entries.pop()
        save(entries)
        restore(entry)
        return
    save(entries)

    if mode != "hide" and in_hidden:                  # hidden before this toggle existed: no record, so bring it to the workspace in front
        active = hj("activeworkspace")
        addr = sorted(in_hidden, key=lambda a: clients[a].get("focusHistoryID", 0))[0]
        restore({"address": addr, "workspace": ws_selector(active)})
        return
    if mode == "show":
        return

    win = hj("activewindow")
    addr = win.get("address") if isinstance(win, dict) else None
    if not addr or win.get("workspace", {}).get("name", "").startswith("special:"):
        return
    entry = {
        "address": addr,
        "workspace": ws_selector(win["workspace"]),
        "floating": bool(win.get("floating")),
        "at": win.get("at", [0, 0]),
        "size": win.get("size", [0, 0]),
        "fullscreen": int(win.get("fullscreen", 0) or 0),
    }
    sel = f'window = "address:{addr}"'
    if entry["fullscreen"]:        # leave full screen first, so the workspace it leaves is not stuck in full-screen mode
        dispatch(f'hl.dsp.window.fullscreen({{ mode = "{"maximized" if entry["fullscreen"] == 1 else "fullscreen"}", action = "unset" }})')
    dispatch(f'hl.dsp.window.move({{ workspace = "{HIDDEN}", follow = false, {sel} }})')
    save(entries + [entry])


main(sys.argv[1] if len(sys.argv) > 1 else "toggle")
